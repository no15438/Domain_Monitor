# ── LLM Provider ─────────────────────────────────────
# Options: "openai" | "anthropic" | "lmstudio" | "dashscope"
LLM_PROVIDER=lmstudio

# Local LM Studio (default)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-35b-a3b

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Alibaba Cloud DashScope (OpenAI-compatible)
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_MODEL=qwen-plus
# International region:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China region:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Data Sources ──────────────────────────────────────
# Tavily Search API (optional, used for chatbot web search)
TAVILY_API_KEY=tvly-...

# NewsAPI.org (optional — free key at https://newsapi.org)
NEWSAPI_KEY=

# Event Registry / newsapi.ai (optional — free key at https://newsapi.ai)
EVENT_REGISTRY_API_KEY=

# RSS feeds (comma-separated, applied globally to all topics)
GLOBAL_RSS_FEEDS=

# Domains excluded from Tavily searches
TAVILY_EXCLUDE_DOMAINS=wikipedia.org,baike.baidu.com,baidu.com,wikiwand.com,britannica.com,zhihu.com

# ── Pipeline Configuration ────────────────────────────
MONITOR_KEYWORDS=artificial intelligence,machine learning
FETCH_INTERVAL_MINUTES=15
MAX_RESULTS_PER_KEYWORD=15

# ── Storage ───────────────────────────────────────────
DATABASE_PATH=./data/monitor.db
CHROMA_PERSIST_DIR=./data/chroma

# ── Server ────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────
# Set this if the backend is not on localhost:8000
# NEXT_PUBLIC_API_BASE=http://localhost:8000
