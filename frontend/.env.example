# Optional. Leave unset when the frontend proxies `/api/*` to the backend
# through Next.js rewrites (recommended for Docker Compose and single-VM deployments).
# Set this only if the browser should call a backend on another public origin.
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Internal backend URL used while building the Docker image.
# Compose already provides http://backend:8000, so you usually do not need to change it.
# INTERNAL_API_BASE=http://backend:8000
