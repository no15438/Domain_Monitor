# LLM Provider: "openai" | "anthropic" | "lmstudio"
LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-35b-a3b

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Data Sources
TAVILY_API_KEY=tvly-...
NEWSAPI_KEY=                              # Get free key at newsapi.org
EVENT_REGISTRY_API_KEY=                   # Get free key at newsapi.ai (Event Registry)

# RSS feeds (comma-separated, applied to all topics)
GLOBAL_RSS_FEEDS=

# Domains to exclude from Tavily searches
TAVILY_EXCLUDE_DOMAINS=wikipedia.org,baike.baidu.com,baidu.com,wikiwand.com,britannica.com,zhihu.com

MONITOR_KEYWORDS=artificial intelligence,machine learning
FETCH_INTERVAL_MINUTES=15
MAX_RESULTS_PER_KEYWORD=3

DATABASE_PATH=./data/monitor.db
CHROMA_PERSIST_DIR=./data/chroma
