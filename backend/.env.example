# LLM Provider: "openai" | "anthropic" | "lmstudio" | "openai_compat" | "dashscope"
#
# 本机 LM Studio
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_API_KEY=lm-studio
#
# 第三方 OpenAI 兼容网关（例：llm.ichonhui.com — 与 LM Studio 无关）
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://example.com/your-route/v1
# OPENAI_COMPAT_MODEL=model-id-from-/v1/models
# OPENAI_COMPAT_API_KEY=

LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Data Sources
TAVILY_API_KEY=tvly-...
NEWSAPI_KEY=                              # Get free key at newsapi.org
EVENT_REGISTRY_API_KEY=                   # Get free key at newsapi.ai (Event Registry)

# RSS feeds (comma-separated, applied to all topics)
GLOBAL_RSS_FEEDS=

# Domains to exclude from Tavily searches
TAVILY_EXCLUDE_DOMAINS=wikipedia.org,baike.baidu.com,baidu.com,wikiwand.com,britannica.com,zhihu.com

MONITOR_KEYWORDS=artificial intelligence,machine learning
FETCH_INTERVAL_MINUTES=15
MAX_RESULTS_PER_KEYWORD=3

# Docker Compose mounts a persistent volume at /app/data.
# These relative defaults still work inside the backend container.
DATABASE_PATH=./data/monitor.db
CHROMA_PERSIST_DIR=./data/chroma

# Comma-separated browser origins allowed to call the backend directly.
# If you only use the frontend's built-in /api proxy, localhost:3000 is enough.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
